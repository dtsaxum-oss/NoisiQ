\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  Aggregate error heatmap for the faithful (non-Clifford) 3-qubit QFT under the \texttt  {ibm\_eagle\_r3} $T_1/T_2$ hardware profile (Pauli-twirled), averaged over 600 trajectory shots. \textbf  {Gate halos} (red scale) reflect downstream propagation burden (Eq.~\ref {eq:burden}); \textbf  {idle halos} (blue scale) reflect $T_1/T_2$ decoherence on idling qubits. The metric box reports the trajectory fidelity $F$, global purity $\text  {Tr}(\rho ^2)$, and zero-error shot fraction. Per-gate error rates are sampled exactly; the burden walk evaluates propagation under Clifford conjugation and treats the non-Clifford CS and $P(\pm \pi /8)$ gates as transparent, so the forward-spread halo component is approximate on those gates. }}{13}{figure.caption.35}\protected@file@percent }
\newlabel{fig:qft_heatmap}{{7}{13}{Aggregate error heatmap for the faithful (non-Clifford) 3-qubit QFT under the \texttt {ibm\_eagle\_r3} $T_1/T_2$ hardware profile (Pauli-twirled), averaged over 600 trajectory shots. \textbf {Gate halos} (red scale) reflect downstream propagation burden (Eq.~\ref {eq:burden}); \textbf {idle halos} (blue scale) reflect $T_1/T_2$ decoherence on idling qubits. The metric box reports the trajectory fidelity $F$, global purity $\text {Tr}(\rho ^2)$, and zero-error shot fraction. Per-gate error rates are sampled exactly; the burden walk evaluates propagation under Clifford conjugation and treats the non-Clifford CS and $P(\pm \pi /8)$ gates as transparent, so the forward-spread halo component is approximate on those gates}{figure.caption.35}{}}
