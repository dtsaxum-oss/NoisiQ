\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Aggregate error heatmap for a 3-qubit Grover search targeting $\ket {111}$ over two iterations, under an \texttt  {ibm\_eagle\_r3} hardware noise profile aggregated over 2\,000 shots. Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the two-qubit CCZ gadgets (the oracle and diffuser reflections) and is minimal on the single-qubit $H$/$X$ layers. The metric box reports the ideal-state fidelity $F = 0.8383$ (overlap of the noisy state with the full noiseless output) and the marked-state success probability $P(\ket {111}) = 0.7944$ (noiseless $\approx 0.94$). The per-qubit marginal purities after tracing out the other qubits are $\mathrm  {Tr}(\rho _{q}^2) \approx 0.81$--$0.82$. }}{17}{figure.caption.45}\protected@file@percent }
\newlabel{fig:grover_heatmap}{{8}{17}{Aggregate error heatmap for a 3-qubit Grover search targeting $\ket {111}$ over two iterations, under an \texttt {ibm\_eagle\_r3} hardware noise profile aggregated over 2\,000 shots. Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the two-qubit CCZ gadgets (the oracle and diffuser reflections) and is minimal on the single-qubit $H$/$X$ layers. The metric box reports the ideal-state fidelity $F = 0.8383$ (overlap of the noisy state with the full noiseless output) and the marked-state success probability $P(\ket {111}) = 0.7944$ (noiseless $\approx 0.94$). The per-qubit marginal purities after tracing out the other qubits are $\mathrm {Tr}(\rho _{q}^2) \approx 0.81$--$0.82$}{figure.caption.45}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  Aggregate error heatmap for the 3-qubit Deutsch--Jozsa algorithm with a balanced oracle, under an \texttt  {ibm\_eagle\_r3} hardware noise profile aggregated over 2\,000 shots. Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the two oracle CNOT layers ($t=2$, $t=3$); the blue gradient shows idle $T_1/T_2$ decoherence accumulating on the input qubits. The metric box reports the ideal-state fidelity $F = 0.9400$ and the marked-state success probability $P(\ket {11}) = 0.9525$ (noiseless $P(\ket {11}) = 1$). }}{17}{figure.caption.47}\protected@file@percent }
\newlabel{fig:dj_heatmap}{{9}{17}{Aggregate error heatmap for the 3-qubit Deutsch--Jozsa algorithm with a balanced oracle, under an \texttt {ibm\_eagle\_r3} hardware noise profile aggregated over 2\,000 shots. Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the two oracle CNOT layers ($t=2$, $t=3$); the blue gradient shows idle $T_1/T_2$ decoherence accumulating on the input qubits. The metric box reports the ideal-state fidelity $F = 0.9400$ and the marked-state success probability $P(\ket {11}) = 0.9525$ (noiseless $P(\ket {11}) = 1$)}{figure.caption.47}{}}
\newlabel{subsec:code_listings}{{A.5}{18}{Code Listings}{section*.50}{}}
\newlabel{lst:pipeline}{{1}{18}{The NoisiQ pipeline. Every example in the paper is this template with a different circuit builder in step (1). Here a GHZ circuit is run under a hardware noise profile and its state fidelity and global purity are reported}{lstlisting.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {1}{\ignorespaces The NoisiQ pipeline. Every example in the paper is this template with a different circuit builder in step (1). Here a GHZ circuit is run under a hardware noise profile and its state fidelity and global purity are reported.}}{18}{lstlisting.1}\protected@file@percent }
\newlabel{lst:noise_hw}{{2}{18}{Passing a noise model from a hardware profile. \texttt {list\_hardware()} enumerates the registry; the chosen profile builds a per-operation channel dictionary}{lstlisting.2}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {2}{\ignorespaces Passing a noise model from a hardware profile. \texttt  {list\_hardware()} enumerates the registry; the chosen profile builds a per-operation channel dictionary.}}{18}{lstlisting.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  Aggregate error heatmap for the three-counting-qubit quantum phase estimation circuit ($U = P(\pi /4)$, $\theta = 1/8$), under an \texttt  {ibm\_eagle\_r3} hardware noise profile (heatmap aggregated over 2\,000 shots). Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the CNOT pairs inside the controlled-$U^{2^k}$ and inverse-QFT controlled-phase gadgets; the blue gradient shows idle $T_1/T_2$ decoherence on the counting qubits. The metric box reports the ideal-state fidelity $F = 0.7414$, the readout success probability $P(\ket {100}) = 0.7580 \pm 0.0175$ from a 600-trajectory pass (noiseless $P(\ket {100}) = 1$), and the recovered phase $\hat  \theta = 1/8$. The counting bitstring is written $q_0 q_1 q_2$ with $q_0$ the least-significant bit. }}{19}{figure.caption.49}\protected@file@percent }
\newlabel{fig:qpe_heatmap}{{10}{19}{Aggregate error heatmap for the three-counting-qubit quantum phase estimation circuit ($U = P(\pi /4)$, $\theta = 1/8$), under an \texttt {ibm\_eagle\_r3} hardware noise profile (heatmap aggregated over 2\,000 shots). Red gate and wire halos encode the expected per-shot gate error burden, which concentrates on the CNOT pairs inside the controlled-$U^{2^k}$ and inverse-QFT controlled-phase gadgets; the blue gradient shows idle $T_1/T_2$ decoherence on the counting qubits. The metric box reports the ideal-state fidelity $F = 0.7414$, the readout success probability $P(\ket {100}) = 0.7580 \pm 0.0175$ from a 600-trajectory pass (noiseless $P(\ket {100}) = 1$), and the recovered phase $\hat \theta = 1/8$. The counting bitstring is written $q_0 q_1 q_2$ with $q_0$ the least-significant bit}{figure.caption.49}{}}
\newlabel{lst:noise_manual}{{3}{19}{A hand-built Pauli noise model. The model is a dict from operation index to a channel; here a larger error rate is assigned to two-qubit gates than to single-qubit gates, with an X bias}{lstlisting.3}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {3}{\ignorespaces A hand-built Pauli noise model. The model is a dict from operation index to a channel; here a larger error rate is assigned to two-qubit gates than to single-qubit gates, with an X bias.}}{19}{lstlisting.3}\protected@file@percent }
