\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Layer-by-layer Pauli-frame snapshots for a single-shot run on a 3-qubit circuit, exported as a static filmstrip from the \texttt  {CircuitAnimator}. At each timestep, the operation time is highlighted with a green box that advances through the circuit left to right, and the current Pauli error operator is carried as a floating label just above the affected qubit wire. \textbf  {(A)} Initial circuit layer: no active errors; all qubit wires are in the identity frame. \textbf  {(B)} X error injected on the data qubit; the Pauli label appears on the affected wire. \textbf  {(C--D)} The X error propagates forward through subsequent entangling gates, spreading to ancilla qubits as the Clifford conjugation rules transform the Pauli frame. \textbf  {(E)} Mid-circuit syndrome measurement fires; the classical outcome signals the presence of the error, and the conditional correction is queued. \textbf  {(F)} Conditional correction applied; the Pauli frame returns to the identity, confirming successful error detection and correction. }}{5}{figure.caption.16}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:filmstrip}{{1}{5}{Layer-by-layer Pauli-frame snapshots for a single-shot run on a 3-qubit circuit, exported as a static filmstrip from the \texttt {CircuitAnimator}. At each timestep, the operation time is highlighted with a green box that advances through the circuit left to right, and the current Pauli error operator is carried as a floating label just above the affected qubit wire. \textbf {(A)} Initial circuit layer: no active errors; all qubit wires are in the identity frame. \textbf {(B)} X error injected on the data qubit; the Pauli label appears on the affected wire. \textbf {(C--D)} The X error propagates forward through subsequent entangling gates, spreading to ancilla qubits as the Clifford conjugation rules transform the Pauli frame. \textbf {(E)} Mid-circuit syndrome measurement fires; the classical outcome signals the presence of the error, and the conditional correction is queued. \textbf {(F)} Conditional correction applied; the Pauli frame returns to the identity, confirming successful error detection and correction}{figure.caption.16}{}}
\newlabel{eq:halo_norm}{{2}{5}{Gate halos: per-gate error contribution and downstream propagation burden}{equation.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Wire halos: idle-time decoherence via Pauli-twirl proxy.}{5}{section*.19}\protected@file@percent }
\newlabel{eq:t1_decay}{{3}{5}{Wire halos: idle-time decoherence via Pauli-twirl proxy}{equation.3}{}}
\newlabel{eq:t2_dephasing}{{4}{5}{Wire halos: idle-time decoherence via Pauli-twirl proxy}{equation.4}{}}
\newlabel{eq:coherent_twirl}{{5}{5}{Wire halos: idle-time decoherence via Pauli-twirl proxy}{equation.5}{}}
\newlabel{eq:wire_intensity}{{6}{5}{Wire halos: idle-time decoherence via Pauli-twirl proxy}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Aggregate error heatmap for a Bell parity-check circuit rendered in \texttt  {[qec]} correction-aware mode under an \texttt  {ibm\_eagle\_r3} hardware noise profile aggregated over 4\,096 shots with a Pauli-twirled noise model. \textbf  {Gate halos} (red scale) show the expected downstream Pauli propagation burden and attached gate noise channel via (Eq.~\ref {eq:burden}). In \texttt  {[qec]} mode the burden walk assumes the mid-circuit correction fires correctly, so only errors that precede or evade the ancilla contribute to the displayed burden. \textbf  {Wire halos} (blue scale) show the idle-time decoherence intensity $I_\mathrm  {wire}$ (Eq.~\ref {eq:wire_intensity}) \newline  \small  This circuit example represents a bit-flip parity repair only; not full Bell-state QEC. }}{6}{figure.caption.20}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{6}{Aggregate error heatmap for a Bell parity-check circuit rendered in \texttt {[qec]} correction-aware mode under an \texttt {ibm\_eagle\_r3} hardware noise profile aggregated over 4\,096 shots with a Pauli-twirled noise model. \textbf {Gate halos} (red scale) show the expected downstream Pauli propagation burden and attached gate noise channel via (Eq.~\ref {eq:burden}). In \texttt {[qec]} mode the burden walk assumes the mid-circuit correction fires correctly, so only errors that precede or evade the ancilla contribute to the displayed burden. \textbf {Wire halos} (blue scale) show the idle-time decoherence intensity $I_\mathrm {wire}$ (Eq.~\ref {eq:wire_intensity}) \newline \small This circuit example represents a bit-flip parity repair only; not full Bell-state QEC}{figure.caption.20}{}}
