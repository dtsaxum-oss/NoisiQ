\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Aggregate error heatmap for a Bell parity-check circuit rendered in \texttt  {[qec]} correction-aware mode under an \texttt  {ibm\_eagle\_r3} hardware noise profile aggregated over 4\,096 shots with a Pauli-twirled noise model. \textbf  {Gate halos} (red scale) show the expected downstream Pauli propagation burden and attached gate noise channel via (Eq.~\ref {eq:burden}). In \texttt  {[qec]} mode the burden walk assumes the mid-circuit correction fires correctly, so only errors that precede or evade the ancilla contribute to the displayed burden. \textbf  {Wire halos} (blue scale) show the idle-time decoherence intensity $I_\mathrm  {wire}$ (Eq.~\ref {eq:wire_intensity}) \newline  \small  This circuit example represents a bit-flip parity repair only; not full Bell-state QEC. }}{6}{figure.caption.20}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{6}{Aggregate error heatmap for a Bell parity-check circuit rendered in \texttt {[qec]} correction-aware mode under an \texttt {ibm\_eagle\_r3} hardware noise profile aggregated over 4\,096 shots with a Pauli-twirled noise model. \textbf {Gate halos} (red scale) show the expected downstream Pauli propagation burden and attached gate noise channel via (Eq.~\ref {eq:burden}). In \texttt {[qec]} mode the burden walk assumes the mid-circuit correction fires correctly, so only errors that precede or evade the ancilla contribute to the displayed burden. \textbf {Wire halos} (blue scale) show the idle-time decoherence intensity $I_\mathrm {wire}$ (Eq.~\ref {eq:wire_intensity}) \newline \small This circuit example represents a bit-flip parity repair only; not full Bell-state QEC}{figure.caption.20}{}}
