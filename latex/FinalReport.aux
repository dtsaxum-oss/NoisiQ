\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Panel mode of the interactive diagnostic interface. \textbf  {Left}: the aggregate error heatmap with gate and wire halos. \textbf  {Right}: the \texttt  {ipywidgets.Output} panel populated by clicking the cursor over the CNOT gate on qubits $[0,\,2]$ at $t=2$ (the cursor sits atop the represented gate location), showing the assigned Pauli channel probabilities $p_X$, $p_Y$, $p_Z$, per-qubit cumulative decoherence, many-shot zero-error survival, and the downstream burden $b_k$ and halo intensity $\tilde  {b}_k$ (Eq.~\ref {eq:burden}, Eq.~\ref {eq:halo_norm}) that determine the gate's color in the heatmap.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:interactive_panel}{{3}{8}{Panel mode of the interactive diagnostic interface. \textbf {Left}: the aggregate error heatmap with gate and wire halos. \textbf {Right}: the \texttt {ipywidgets.Output} panel populated by clicking the cursor over the CNOT gate on qubits $[0,\,2]$ at $t=2$ (the cursor sits atop the represented gate location), showing the assigned Pauli channel probabilities $p_X$, $p_Y$, $p_Z$, per-qubit cumulative decoherence, many-shot zero-error survival, and the downstream burden $b_k$ and halo intensity $\tilde {b}_k$ (Eq.~\ref {eq:burden}, Eq.~\ref {eq:halo_norm}) that determine the gate's color in the heatmap}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hover (tooltip) mode of the interactive diagnostic interface. Hovering the cursor over an element (here the idle interval on qubit $[2]$ at $t=1$, with the cursor sitting atop the represented location) raises an inline tooltip reporting the gate type and timestep, the noise-model gate-error bounds, the assigned Pauli channel probabilities, per-qubit accumulated bit/phase decoherence, the many-shot observed errors-per-shot and zero-error survival, and the downstream burden $b_k$ and halo intensity $\tilde  {b}_k$ (Eq.~\ref {eq:burden}, Eq.~\ref {eq:halo_norm}) that determine the element's color in the heatmap.}}{8}{figure.caption.22}\protected@file@percent }
\newlabel{fig:interactive_annotate}{{4}{8}{Hover (tooltip) mode of the interactive diagnostic interface. Hovering the cursor over an element (here the idle interval on qubit $[2]$ at $t=1$, with the cursor sitting atop the represented location) raises an inline tooltip reporting the gate type and timestep, the noise-model gate-error bounds, the assigned Pauli channel probabilities, per-qubit accumulated bit/phase decoherence, the many-shot observed errors-per-shot and zero-error survival, and the downstream burden $b_k$ and halo intensity $\tilde {b}_k$ (Eq.~\ref {eq:burden}, Eq.~\ref {eq:halo_norm}) that determine the element's color in the heatmap}{figure.caption.22}{}}
